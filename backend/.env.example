# Aura Watch AI - Backend Environment Variables Template

# Server Port and Environment
PORT=5000
NODE_ENV=development

# JWT authentication (required for multi-org)
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRES_IN=7d

# Optional: seed a bootstrap admin on first startup
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-password

# Super admin console (/admin) — fixed password for viewing all orgs and impersonation
SUPER_ADMIN_PASSWORD=aura-admin

# MongoDB Connection String (via Prisma)
# Example: mongodb://username:password@host:port/dbname?authSource=admin&directConnection=true
DATABASE_URL="mongodb://localhost:27017/aura-watch?authSource=admin"

# Qdrant Vector Database Connection
# Local: http://localhost:6333
# Reverse proxy (Nginx Proxy Manager): https://qdrant.yourdomain.com (use https; client maps to port 443)
QDRANT_URL=http://localhost:6333
# Set your Qdrant API Key (leave empty for local instances without authentication)
QDRANT_API_KEY=""

# AI Provider Configuration
# Note: AI service provider choices (gemini, openai, or openrouter) are now centrally
# configured as code-level constants in backend/src/services/ai/index.ts.
# The environment variables below are no longer used for routing provider logic,
# but their respective API keys and model overrides are still required.

# Google Gemini API Key (Required for Video clip summarization via Gemini)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# OpenAI API Key (Required if AI_PROVIDER is set to 'openai')
OPENAI_API_KEY="your_openai_api_key_here"

# OpenRouter API Key (Required if using openrouter provider)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
# Note: OpenRouter models (CHAT_MODEL, VIDEO_MODEL, EMBEDDING_MODEL, and USE_NATIVE_VIDEO)
# are configured directly as code-level constants in backend/src/services/ai/openrouter.ts.

# Local Storage Directory for temporary video uploads
VIDEO_STORAGE_DIR="./storage/videos"

# ReID (OSNet) runs on edge devices — no backend ReID worker required.

# WiFi credential encryption key (AES-256-GCM)
# Used to encrypt WiFi passwords stored for edge devices.
# Generate a secure value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, WiFi credentials will still be pushed to the device over WebSocket
# but WON'T be persisted in the database.
WIFI_CREDENTIAL_SECRET="change-this-to-a-random-64-char-hex-string"

# Tailscale auth key for remote SSH to edge devices (optional)
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx
