[Unit]
Description=Aura Watch AI Edge Surveillance Agent
# Run after WiFi provisioning check (AP fallback if no WiFi)
After=network-online.target aura-watch-wifi-setup.service
Wants=network-online.target
# Wait for WiFi setup to finish before starting the agent
After=aura-watch-wifi-setup.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON__ -u __DIR__/main.py
# Restart unless explicitly stopped via `systemctl stop`
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
