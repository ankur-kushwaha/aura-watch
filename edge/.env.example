# Cloud Hub API server configurations
# Device/stream defaults live in config/edge-device-defaults.json (repo root).
# Values below are env overrides for the edge agent only.
CLOUD_URL=https://aura-watch.adboardtools.com

# Organization ID (use as ENROLLMENT_TOKEN so the edge agent joins your org)
# ENROLLMENT_TOKEN=674a1b2c3d4e5f6789012345

# Tailscale auth key for remote SSH during install (optional; also set TAILSCALE_AUTH_KEY on the hub)
# Generate at https://login.tailscale.com/admin/settings/keys
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxx

# Edge Device details (Optional, defaults will be used if omitted)
DEVICE_NAME="Office Edge Pi"

# Verbose edge + FFmpeg logs (true = FFmpeg -loglevel info; false = errors only)
DEBUG_LOGS=true
# Override FFmpeg verbosity: quiet | error | warning | info | verbose | debug
# FFMPEG_LOGLEVEL=verbose

# Camera capture resolution
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Camera capture + clip encode FPS
CAMERA_FPS=15
# Seconds without a camera frame before reconnecting
CAMERA_STALL_TIMEOUT_SEC=45

# Low-latency WebSocket preview — default: config/edge-device-defaults.json (livePreviewEnabled)
# Optional env override on the edge device only: LIVE_PREVIEW_ENABLED=true
FRAME_STREAM_FPS=8
PREVIEW_JPEG_QUALITY=65
# Seconds without a preview frame before reporting a frozen live feed to the UI
PREVIEW_STALL_TIMEOUT_SEC=5

# Record while motion is active, up to this many seconds per clip
RECORDING_MAX_SEC=90

# Seconds without motion before ending a clip
RECORDING_END_GRACE_SEC=12

# Seconds to wait after a clip finishes before allowing another recording
RECORDING_COOLDOWN_SEC=60

# Skip hub notification for clips shorter than this (0 = no minimum)
MIN_UPLOAD_DURATION_SEC=8

# Seconds of pre-roll buffered before motion triggers a clip
CLIP_PREROLL_SEC=3

# RTSP transport: tcp, udp, or auto (tries tcp then udp)
RTSP_TRANSPORT=tcp

# Optional: bind RTSP client to a specific local interface IP (e.g. 192.168.18.69)
# RTSP_LOCAL_ADDR=192.168.18.69

# Optional: remote MediaMTX server stream push URL (e.g. rtsp://mediamtx.adboardtools.com:8554/live)
# If set, clips will be pushed live to this target as an RTSP stream while recording.
# REMOTE_STREAM_URL=rtsp://mediamtx.adboardtools.com:8554/live

# Edge YOLO (experimental — enable per stream in dashboard stream config)
# YOLO_MODEL_PATH=models/yolo11n.onnx
# YOLO_IMGSZ=320
# YOLO_DETECT_INTERVAL=3
# YOLO_CONFIDENCE=0.35
